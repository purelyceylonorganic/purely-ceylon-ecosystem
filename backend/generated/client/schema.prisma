generator client {
  provider = "prisma-client-js"
  output   = "../generated/client" // 💎 இந்த வரியை மட்டும் புதிதாகச் சேர்க்கவும்!
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 🛡️ மேம்படுத்தப்பட்ட எண்டர்பிரைஸ் பயனர் மாதிரி (Enterprise User Model)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String // 👈 இப்போது 'password' ஃபீல்டு கச்சிதமாக சேர்க்கப்பட்டுவிட்டது!
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// பயனர் நிலைகளுக்கான Enum அடுக்கு
enum Role {
  ADMIN
  CUSTOMER
}
