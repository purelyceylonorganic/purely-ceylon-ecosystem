datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VENDOR
  STAFF
  ADMIN
  SUPER_ADMIN
}

// 👤 பயனர் அட்டவணை (User Model) - இணைக்கப்பட்டது
model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  fullName     String
  phone        String?
  role         Role    @default(CUSTOMER)

  // Account Status
  isActive Boolean @default(false)

  // Legacy Email Verification (optional)
  verificationToken String?

  // OTP Verification
  verificationOtp String?
  otpExpiresAt    DateTime?
  otpLastSentAt   DateTime?

  // Security Protection
  otpAttempts         Int @default(0)
  failedLoginAttempts Int @default(0)

  otpLockedUntil     DateTime?
  accountLockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  addresses Address[]
  orders    Order[]
  reviews   Review[]
  sessions  UserSession[]
  auditLogs AuditLog[]

  cart Cart?
}

// 🔒 செக்யூரிட்டி செஷன்ஸ் (Zero Trust Session Tracking)
model UserSession {
  id            String   @id @default(uuid())
  userId        String
  token         String   @unique
  ipAddress     String?
  userAgent     String?
  isRiskFlagged Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 📦 தயாரிப்புகள் (Product Catalog)
model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  categoryId  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relations
  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[] // 🆕 Variants உடன் தொடர்பு
  images   ProductImage[]
  videos   ProductVideo[]
  reviews  Review[]
}

model CurrencyRate {
  id        String   @id @default(uuid())
  code      String   @unique
  rate      Float
  updatedAt DateTime @updatedAt
}

// 🆕 Variants மாடல் (இங்குதான் SKU மற்றும் Stock இருக்கும்)
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  sku       String @unique
  weight    String // எ.கா: "50g", "100g"
  price     Float // தற்போதைய basePrice-க்கு பதில்
  costPrice Float  @default(0.0)
  stock     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  orderItems OrderItem[]
  cartItems  CartItem[]
  inventory  Inventory[]
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id        String  @id @default(uuid())
  productId String
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  products Product[]
}

// 🛒 ஆர்டர் மற்றும் பரிவர்த்தனைகள் (Orders & Commerce Engine)
model Order {
  id            String        @id @default(uuid())
  userId        String
  addressId    String?
  user          User          @relation(fields: [userId], references: [id])

  // =========================
  // 💰 PRICING (MULTI CURRENCY)
  // =========================
  totalUSD      Float
  currency      String
  exchangeRate  Float
  totalFinal    Float

  // =========================
  // 🇱🇰 TAX SYSTEM (Sri Lanka)
  // =========================
  taxAmount     Float        @default(0)
  shippingCost  Float        @default(0)

  // =========================
  // 💳 PAYMENT SYSTEM
  // =========================
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?       // COD, PAYHERE, STRIPE

  payments      Payment[]

  // =========================
  // 📦 ORDER STATUS
  // =========================
  status        OrderStatus   @default(PENDING)
  shippingStatus ShippingStatus @default(PENDING)

  trackingId    String?

  // =========================
  // 🧾 RELATIONS
  // =========================
  items         OrderItem[]

  // =========================
  // 🕒 TIMESTAMPS
  // =========================
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 🛒 OrderItem (இனி Variant-ஐச் சார்ந்தது)
model OrderItem {
  id               String @id @default(uuid())

  orderId          String
  order            Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  // =========================
  // 💰 PRICE SNAPSHOT (IMPORTANT)
  // =========================
  quantity         Int
  price            Float

  // =========================
  // 🕒 OPTIONAL AUDIT (GOOD PRACTICE)
  // =========================
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum ShippingStatus {
  PENDING
  PACKED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  transactionId String   @unique
  amount        Float
  gateway       String
  rawWebhookLog String? // பாதுகாப்பு தணிக்கைக்காக
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Address {
  id         String  @id @default(uuid())
  userId     String
  street     String
  city       String
  province   String // இலங்கை மாகாணங்கள்
  postalCode String
  country    String  @default("Sri Lanka")
  isDefault  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

// 🛒 CartItem (இனி Variant-ஐச் சார்ந்தது)
model CartItem {
  id               String @id @default(uuid())
  cartId           String
  productVariantId String // 🆕 productId-க்கு பதில்
  quantity         Int    @default(1)

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  createdAt DateTime @default(now())
}

// 🛡️ எண்டர்பிரைஸ் தணிக்கை பதிவுகள் (Immutable Audit Logs)
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String // எ.கா: "UPDATE_PRICE", "DELETE_USER"
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// 🏢 Warehouse Management
model Warehouse {
  id        String      @id @default(uuid())
  name      String
  location  String
  inventory Inventory[]
}

// 📦 Inventory மாடல் திருத்தம்
model Inventory {
  id               String @id @default(uuid())
  warehouseId      String
  productVariantId String
  quantity         Int    @default(0)

  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  transactions InventoryTransaction[]

  stockAlerts StockAlert[] // ✅ ADD THIS

  @@unique([warehouseId, productVariantId])
}

// 🔄 Inventory Transactions (இருப்பு மாற்றம் - வரவு/செலவு)
model InventoryTransaction {
  id          String          @id @default(uuid())
  inventoryId String
  type        TransactionType // Enum: STOCK_IN, STOCK_OUT, ADJUSTMENT
  quantity    Int
  createdAt   DateTime        @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])
}

// ⚠️ Stock Alerts
model StockAlert {
  id          String   @id @default(uuid())
  inventoryId String?
  message     String
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  inventory Inventory? @relation(fields: [inventoryId], references: [id])
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}
model Farmer {
  id        String   @id @default(uuid())
  fullName  String
  farms     Farm[]
  createdAt DateTime @default(now())
}

model Farm {
  id        String   @id @default(uuid())
  farmName  String
  location  String

  farmerId  String
  farmer    Farmer @relation(fields: [farmerId], references: [id])

  batches   Batch[]

  createdAt DateTime @default(now())
}

model Batch {
  id            String   @id @default(uuid())
  batchNumber   String   @unique
  harvestDate   DateTime

  farmId        String
  farm          Farm @relation(fields: [farmId], references: [id])

  traceability  TraceabilityRecord?
  certificates  Certificate[]

  createdAt     DateTime @default(now())
}

model TraceabilityRecord {
  id         String @id @default(uuid())
  farmOrigin String
  qrCode     String?

  batchId    String @unique
  batch      Batch @relation(fields: [batchId], references: [id])
}

model Certificate {
  id              String   @id @default(uuid())
  certificateName String
  certificateNo   String

  batchId         String
  batch           Batch @relation(fields: [batchId], references: [id])

  createdAt       DateTime @default(now())
}
