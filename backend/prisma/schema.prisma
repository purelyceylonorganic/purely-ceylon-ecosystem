datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  VENDOR
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum BuyerTier {
  BRONZE
  SILVER
  GOLD
  DISTRIBUTOR
}

// 👤 பயனர் அட்டவணை (User Model) - திருத்தப்பட்டது
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  phone        String?
  
  // 🚀 சரி செய்யப்பட்டது: ஒரே ஒரு role புலம், சரியான UserRole enum உடன்
  role         UserRole @default(CUSTOMER)

  // Account Status
  isActive Boolean @default(false)

  // Legacy Email Verification (optional)
  verificationToken String?

  // OTP Verification
  verificationOtp String?
  otpExpiresAt    DateTime?
  otpLastSentAt   DateTime?

  // Security Protection
  otpAttempts         Int @default(0)
  failedLoginAttempts Int @default(0)

  otpLockedUntil      DateTime?
  accountLockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  addresses Address[]
  orders    Order[]
  sessions  UserSession[]
  auditLogs AuditLog[]

  cart      Cart?
  wishlist  Wishlist?
  reviews   Review[]      @relation("UserReviews")
  questions Question[]    @relation("UserQuestions")
}

// 🔒 செக்யூரிட்டி செஷன்ஸ் (Zero Trust Session Tracking)
model UserSession {
  id            String   @id @default(uuid())
  userId        String
  token         String   @unique
  ipAddress     String?
  userAgent     String?
  isRiskFlagged Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 🔑 பயனர் பாத்திரங்கள் (User Roles)
enum UserRole {
  SUPER_ADMIN
  ADMIN
  EXPORT_MANAGER
  FINANCE
  WAREHOUSE_MANAGER
  FARM_MANAGER
  BUYER
  CUSTOMER
}

// 📦 தயாரிப்புகள் (Product Catalog)
model Product {
  id          String @id @default(uuid())
  name        String
  slug        String @unique
  description String
  categoryId  String

  moq       Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  category  Category         @relation(fields: [categoryId], references: [id])
  variants  ProductVariant[] // 🆕 Variants உடன் தொடர்பு
  images    ProductImage[]
  videos    ProductVideo[]
  reviews   Review[]         @relation("ProductReviews")
  questions Question[]       @relation("ProductQuestions")
}

model CurrencyRate {
  id        String   @id @default(uuid())
  code      String   @unique
  rate      Float
  updatedAt DateTime @updatedAt
}

// 🆕 Variants மாடல் (இங்குதான் SKU மற்றும் Stock இருக்கும்)
model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  sku       String @unique
  weight    String // எ.கா: "50g", "100g"
  price     Float // தற்போதைய basePrice-க்கு பதில்
  costPrice Float  @default(0.0)
  stock     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  orderItems    OrderItem[]
  cartItems     CartItem[]
  inventory     Inventory[]
  wishlistItems WishlistItem[]
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  isPrimary Boolean @default(false)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id        String  @id @default(uuid())
  productId String
  url       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id       String    @id @default(uuid())
  name     String
  slug     String    @unique
  products Product[]
}

// 🛒 ஆர்டர் மற்றும் பரிவர்த்தனைகள் (Orders & Commerce Engine)
model Order {
  id String @id @default(uuid())

  userId    String
  addressId String?

  user User @relation(fields: [userId], references: [id])

  address Address? @relation(fields: [addressId], references: [id])

  totalUSD     Float
  currency     String
  exchangeRate Float
  totalFinal   Float

  taxAmount    Float @default(0)
  shippingCost Float @default(0)

  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?

  payments Payment[]

  status         OrderStatus    @default(PENDING)
  shippingStatus ShippingStatus @default(PENDING)

  trackingId String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 🛒 OrderItem (இனி Variant-ஐச் சார்ந்தது)
model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  // =========================
  // 💰 PRICE SNAPSHOT (IMPORTANT)
  // =========================
  quantity Int
  price    Float

  // =========================
  // 🕒 OPTIONAL AUDIT (GOOD PRACTICE)
  // =========================
  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum ShippingStatus {
  PENDING
  PACKED
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  transactionId String   @unique
  amount        Float
  gateway       String
  rawWebhookLog String? // பாதுகாப்பு தணிக்கைக்காக
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])
}

model Address {
  id String @id @default(uuid())

  userId String

  street     String
  city       String
  province   String
  postalCode String

  country String @default("Sri Lanka")

  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  orders Order[]
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

// 🛒 CartItem (இனி Variant-ஐச் சார்ந்தது)
model CartItem {
  id               String @id @default(uuid())
  cartId           String
  productVariantId String // 🆕 productId-க்கு பதில்
  quantity         Int    @default(1)

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  createdAt DateTime @default(now())
}

// ❤️ Wishlist
model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WishlistItem[]
}

// ❤️ Wishlist Items
model WishlistItem {
  id               String @id @default(uuid())
  wishlistId       String
  productVariantId String

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  createdAt DateTime @default(now())

  @@unique([wishlistId, productVariantId])
}

// 🏢 Warehouse Management
model Warehouse {
  id        String      @id @default(uuid())
  name      String
  location  String
  inventory Inventory[]
}

// 📦 Inventory மாடல் திருத்தம்
model Inventory {
  id String @id @default(uuid())

  warehouseId      String
  productVariantId String

  quantity      Int @default(0)
  minStockLevel Int @default(10)

  // Relations
  warehouse      Warehouse      @relation(fields: [warehouseId], references: [id])
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  transactions InventoryTransaction[]
  stockAlerts  StockAlert[]

  // Ensure one inventory record per product per warehouse
  @@unique([warehouseId, productVariantId])
}

// 🔄 Inventory Transactions (இருப்பு மாற்றம் - வரவு/செலவு)
model InventoryTransaction {
  id          String          @id @default(uuid())
  inventoryId String
  type        TransactionType // Enum: STOCK_IN, STOCK_OUT, ADJUSTMENT
  quantity    Int
  createdAt   DateTime        @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id])
}

// ⚠️ Stock Alerts
model StockAlert {
  id          String   @id @default(uuid())
  inventoryId String?
  message     String
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  inventory Inventory? @relation(fields: [inventoryId], references: [id])
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model Farmer {
  id        String   @id @default(uuid())
  fullName  String
  farms     Farm[]
  createdAt DateTime @default(now())
}

model Farm {
  id       String @id @default(uuid())
  farmName String
  location String

  farmerId String
  farmer   Farmer @relation(fields: [farmerId], references: [id])

  batches Batch[]

  createdAt DateTime @default(now())
}

model Batch {
  id          String   @id @default(uuid())
  batchNumber String   @unique
  harvestDate DateTime

  farmId String
  farm   Farm   @relation(fields: [farmId], references: [id])

  traceability TraceabilityRecord?
  certificates Certificate[]

  createdAt DateTime @default(now())
}

model TraceabilityRecord {
  id         String  @id @default(uuid())
  farmOrigin String
  qrCode     String?

  batchId String @unique
  batch   Batch  @relation(fields: [batchId], references: [id])
}

model Certificate {
  id              String @id @default(uuid())
  certificateName String
  certificateNo   String

  batchId String
  batch   Batch  @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
}

model TaxRate {
  id String @id @default(cuid())

  country String
  taxName String
  rate    Float

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id   String @id @default(uuid())
  code String @unique

  description String?

  discountType  DiscountType
  discountValue Float

  minOrderAmount    Float?
  maxDiscountAmount Float?

  startDate DateTime
  endDate   DateTime

  usageLimit Int?
  usedCount  Int  @default(0)

  perUserLimit Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  histories CouponUsage[]
}

model CouponUsage {
  id String @id @default(uuid())

  userId   String
  couponId String

  orderId String?

  usedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@index([userId])
  @@index([couponId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model WholesaleBuyer {
  id         String  @id @default(cuid())
  name       String
  email      String  @unique
  phone      String?
  password   String
  isVerified Boolean @default(false)

  tier BuyerTier @default(BRONZE)

  companyProfile CompanyProfile?

  rfqs       RFQ[]
  bulkOrders BulkOrder[]

  createdAt DateTime @default(now())
}

model CompanyProfile {
  id String @id @default(cuid())

  companyName    String
  registrationNo String
  country        String
  address        String

  taxNumber String?
  website   String?

  buyerId String         @unique
  buyer   WholesaleBuyer @relation(fields: [buyerId], references: [id])
}

model RFQ {
  id String @id @default(cuid())

  buyerId String
  buyer   WholesaleBuyer @relation(fields: [buyerId], references: [id])

  status String @default("PENDING")

  quotedPrice Float?
  quoteNote   String?
  quotedAt    DateTime?

  createdAt DateTime @default(now())

  items RFQItem[]

  bulkOrder   BulkOrder? @relation(fields: [bulkOrderId], references: [id])
  bulkOrderId String?
}

model RFQItem {
  id String @id @default(cuid())

  rfqId String
  rfq   RFQ    @relation(fields: [rfqId], references: [id])

  productId String
  quantity  Int
}

model BulkOrder {
  id String @id @default(cuid())

  buyerId String
  buyer   WholesaleBuyer @relation(fields: [buyerId], references: [id])

  rfqId String @unique

  status String @default("PENDING")

  totalAmount Float

  paymentStatus String @default("UNPAID")

  paymentMethod String?

  paidAt DateTime?

  transactionId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  items BulkOrderItem[]

  statusHistory BulkOrderStatusHistory[]

  invoice ExportInvoice?

  exportDocument ExportDocument?

  shipment Shipment?

  RFQ RFQ[]
}

model BulkOrderItem {
  id String @id @default(cuid())

  bulkOrderId String
  bulkOrder   BulkOrder @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)

  productId String
  quantity  Int
  price     Float

  totalPrice Float?
}

model BulkOrderStatusHistory {
  id String @id @default(cuid())

  bulkOrderId String
  bulkOrder   BulkOrder @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)

  previousStatus String
  currentStatus  String

  remarks String?

  changedBy String?

  createdAt DateTime @default(now())
}

model ExportInvoice {
  id String @id @default(cuid())

  invoiceNumber String @unique

  bulkOrderId String    @unique
  bulkOrder   BulkOrder @relation(fields: [bulkOrderId], references: [id])

  invoiceDate DateTime @default(now())

  subtotal     Float
  tax          Float @default(0)
  shippingCost Float @default(0)

  totalAmount Float

  currency String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExportDocument {
  id String @id @default(cuid())

  bulkOrderId String    @unique
  bulkOrder   BulkOrder @relation(fields: [bulkOrderId], references: [id])

  commercialInvoice Boolean @default(false)

  packingList Boolean @default(false)

  certificateOfOrigin Boolean @default(false)

  billOfLading String?

  customsReference String?

  status String @default("PENDING")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Shipment {
  id String @id @default(cuid())

  shipmentNumber String @unique

  bulkOrderId String    @unique
  bulkOrder   BulkOrder @relation(fields: [bulkOrderId], references: [id])

  shippingLine String

  containerNumber String?

  vesselName String?

  trackingNumber String?

  portOfLoading String

  destinationPort String

  etd DateTime?

  eta DateTime?

  status String @default("BOOKED")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Review {
  id      String  @id @default(uuid())
  rating  Int
  comment String?

  userId    String
  productId String

  // 👈 கீழே உள்ள இரண்டு வரிகளிலும் @relation("...") பெயர் சேர்க்கப்பட்டுள்ளது
  user    User    @relation("UserReviews", fields: [userId], references: [id])
  product Product @relation("ProductReviews", fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Question {
  id String @id @default(uuid())

  question String
  answer   String?

  userId    String
  productId String

  user    User    @relation("UserQuestions", fields: [userId], references: [id])
  product Product @relation("ProductQuestions", fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  userEmail String?

  action String

  module String

  entityId String?

  description String?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())
}
